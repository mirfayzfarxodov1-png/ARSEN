{
  "manifest_version": 3,
  "name": "ARSEN in Chrome",
  "version": "1.0.0",
  "description": "Ask ARSEN for help and insert approved text into the current page.",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "http://localhost:3000/*"
  ],
  "action": {
    "default_title": "ARSEN in Chrome",
    "default_popup": "popup.html"
  }
}
