{
  "manifest_version": 3,
  "name": "ARSEN in Chrome",
  "version": "1.1.0",
  "description": "Local ARSEN assistant with user-triggered website navigation and web search.",
  "permissions": [
    "activeTab",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "http://localhost:3000/*"
  ],
  "action": {
    "default_title": "ARSEN in Chrome",
    "default_popup": "popup.html"
  }
}
